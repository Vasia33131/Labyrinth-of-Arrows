  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 7d3f1a92c4b84e5aa1f0b6c2d9e83745, type: 3}
    m_FontSize: 28
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 30
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.22
  m_Text: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F \u0443\u043A\u0430\u0437\u043A\u0430
    \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043A\u043B\u0435\u0442\u043E\u043A \u0438 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u043F\u0443\u0442\u044C.\n\n\u0415\u0451 \u043D\u0435\u043B\u044C\u0437\u044F
    \u0443\u0431\u0440\u0430\u0442\u044C \u0442\u0430\u043F\u043E\u043C. \u041F\u043E\u0441\u043B\u0435
    \u043A\u0430\u0436\u0434\u043E\u0439 \u0443\u0441\u043F\u0435\u0448\u043D\u043E
    \u0443\u0431\u0440\u0430\u043D\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0438
    \u0443\u043A\u0430\u0437\u043A\u0430 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 90\xB0 \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0432\u043E\u0435\u0433\u043E
    \u043D\u0430\u0447\u0430\u043B\u0430.\n\n\u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0439
    \u0441\u0442\u0440\u0435\u043B\u043A\u0443, \u043F\u043E\u043A\u0430 \u0443\u043A\u0430\u0437\u043A\u0430
    \u043D\u0435 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u043B\u0430 \u043A\u043E\u0440\u0438\u0434\u043E\u0440."
